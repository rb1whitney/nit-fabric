### TACTICAL REMEDIATION: AWS CLI ###
Finding: {{ id }}

# PROPOSED SHELL COMMANDS:
{% if id == 'AWS_PUBLIC_S3' %}
# Expert Note: Applying account-level and bucket-level public access block.
aws s3api put-public-access-block \
    --bucket {{ bucket_name | shell_quote }} \
    --public-access-block-configuration "BlockPublicAcls=true,IgnorePublicAcls=true,BlockPublicPolicy=true,RestrictPublicBuckets=true"

{% elif id == 'UNRESTRICTED_INGRESS' %}
# Expert Note: Using specific rule ID for surgical revocation.
aws ec2 revoke-security-group-ingress \
    --group-id {{ (group_id | default(rule.group_id | default('sg-unknown'))) | shell_quote }} \
    --security-group-rule-ids {{ rule.rule_id | shell_quote }}

{% elif id == 'PRIVATE_ACCESS_AUDIT' %}
# Expert Note: Enabling Private DNS for Interface Endpoint to ensure internet excision.
aws ec2 modify-vpc-endpoint \
    --vpc-endpoint-id {{ (vpce_id | default(vpc_id)) | shell_quote }} \
    --private-dns-enabled
{% endif %}
